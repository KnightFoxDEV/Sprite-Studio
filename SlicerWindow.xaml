<Window x:Class="SpriteStudio.SlicerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slicer" Icon="Assets/SpriteStudio.png" Width="1180" Height="760" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Viewbox="0,0,16,16" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#555A56" Geometry="M0,0 H16 V16 H0 Z" />
                    <GeometryDrawing Brush="#686D69" Geometry="M0,0 H8 V8 H0 Z" />
                    <GeometryDrawing Brush="#686D69" Geometry="M8,8 H16 V16 H8 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <SolidColorBrush x:Key="ImageAreaBackground" Color="#777D78" />
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="NumericInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Grid Margin="9">
        <Grid.RowDefinitions>
            <RowDefinition Height="39" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="6,3">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenImageButton" Content="Abrir imagem" Click="OpenImageButton_Click" Padding="9,5" FontSize="10" Margin="0,0,6,0" />
                    <Border Width="1" Height="23" Background="{DynamicResource BorderBrush}" Margin="2,0,7,0" />
                    <Button x:Name="RotateRightButton" Content="↻" ToolTip="Girar 90° à direita" Click="RotateRightButton_Click" Padding="9,4" FontSize="14" IsEnabled="False" Margin="0,0,4,0" />
                    <Button x:Name="RotateLeftButton" Content="↺" ToolTip="Girar 90° à esquerda" Click="RotateLeftButton_Click" Padding="9,4" FontSize="14" IsEnabled="False" Margin="0,0,4,0" />
                    <Button x:Name="FlipVerticalButton" Content="↕" ToolTip="Inverter na vertical" Click="FlipVerticalButton_Click" Padding="9,4" FontSize="13" IsEnabled="False" Margin="0,0,4,0" />
                    <Button x:Name="FlipHorizontalButton" Content="↔" ToolTip="Inverter na horizontal" Click="FlipHorizontalButton_Click" Padding="9,4" FontSize="13" IsEnabled="False" />
                </StackPanel>
                <TextBlock x:Name="SourceInfoText" Text="Arraste uma imagem para começar" Foreground="{DynamicResource MutedBrush}" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Bottom">
                        <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock x:Name="DimensionTitle" Text="Dimensão do sprite" Style="{StaticResource SectionHeader}" />
                                <ComboBox x:Name="SpriteSizeCombo" SelectedIndex="0" SelectionChanged="SpriteSizeCombo_SelectionChanged">
                                    <ComboBoxItem Content="32 × 32" Tag="32" />
                                    <ComboBoxItem Content="64 × 64" Tag="64" />
                                    <ComboBoxItem Content="128 × 128" Tag="128" />
                                    <ComboBoxItem Content="256 × 256" Tag="256" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Button x:Name="AutoDetectButton" Content="Detectar grade automaticamente" Click="AutoDetectButton_Click" IsEnabled="False" Margin="0,0,0,8" ToolTip="Sugere dimensão e posição com base nos pixels visíveis" />

                        <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock x:Name="CellsTitle" Text="Células" Style="{StaticResource SectionHeader}" />
                                <CheckBox x:Name="SubdivisionsCheckBox" Content="Subdivisões" Checked="GridOptions_Changed" Unchecked="GridOptions_Changed" Margin="1,1,0,5" />
                                <CheckBox x:Name="ShowTileGridCheckBox" Content="Grade 32 × 32" IsChecked="True" Checked="GridOptions_Changed" Unchecked="GridOptions_Changed" Margin="1,1,0,5" />
                                <CheckBox x:Name="EmptySpritesCheckBox" Content="Sprites vazios" Margin="1,1,0,7" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" /></Grid.RowDefinitions>
                                    <TextBlock x:Name="XLabel" Text="X:" Grid.Row="0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBox x:Name="XInput" Grid.Row="0" Grid.Column="1" Text="0" Style="{StaticResource NumericInput}" TextChanged="GridOptions_TextChanged" LostFocus="NumericInput_LostFocus" PreviewTextInput="DigitsOnly" />
                                    <TextBlock x:Name="YLabel" Text="Y:" Grid.Row="1" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBox x:Name="YInput" Grid.Row="1" Grid.Column="1" Text="0" Style="{StaticResource NumericInput}" TextChanged="GridOptions_TextChanged" LostFocus="NumericInput_LostFocus" PreviewTextInput="DigitsOnly" />
                                    <TextBlock x:Name="ColumnsLabel" Text="Colunas:" Grid.Row="2" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBox x:Name="ColumnsInput" Grid.Row="2" Grid.Column="1" Text="1" Style="{StaticResource NumericInput}" TextChanged="GridOptions_TextChanged" LostFocus="NumericInput_LostFocus" PreviewTextInput="DigitsOnly" />
                                    <TextBlock x:Name="RowsLabel" Text="Linhas:" Grid.Row="3" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBox x:Name="RowsInput" Grid.Row="3" Grid.Column="1" Text="1" Style="{StaticResource NumericInput}" TextChanged="GridOptions_TextChanged" LostFocus="NumericInput_LostFocus" PreviewTextInput="DigitsOnly" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock x:Name="ZoomTitle" Text="Zoom" Style="{StaticResource SectionHeader}" Margin="0" />
                                    <TextBlock x:Name="ZoomValueText" Text="100%" Foreground="{DynamicResource MutedBrush}" FontSize="9" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                </DockPanel>
                                <Slider x:Name="ZoomSlider" Minimum="0.1" Maximum="5" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="False" ValueChanged="ZoomSlider_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="CropButton" Content="Recortar" Style="{StaticResource PrimaryButton}" Click="CropButton_Click" IsEnabled="False" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Margin="8,0" Padding="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="27" /><RowDefinition Height="*" /><RowDefinition Height="82" /></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="8,0">
                        <TextBlock x:Name="CanvasTitle" Text="Imagem" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock x:Name="CanvasHint" Text="Arraste a área verde para ajustar o recorte" Foreground="{DynamicResource MutedBrush}" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </DockPanel>
                    <ScrollViewer x:Name="ImageScrollViewer" Grid.Row="1" Background="{StaticResource CheckerBrush}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="ImageCanvas" Background="{StaticResource ImageAreaBackground}" MouseLeftButtonDown="ImageCanvas_MouseLeftButtonDown" MouseMove="ImageCanvas_MouseMove" MouseLeftButtonUp="ImageCanvas_MouseLeftButtonUp" />
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="7,5,7,2" Padding="6">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Width="62" Height="62" Background="{StaticResource CheckerBrush}" CornerRadius="4" Margin="0,0,8,0">
                                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Width="120">
                                <TextBlock x:Name="PreviewTitle" Text="Prévia da animação" FontWeight="SemiBold" FontSize="9" />
                                <TextBlock x:Name="PreviewFrameText" Text="0 / 0" Foreground="{DynamicResource MutedBrush}" FontSize="8" Margin="0,3,0,4" />
                                <Button x:Name="PreviewButton" Content="▶ Reproduzir" Click="PreviewButton_Click" IsEnabled="False" Padding="6,3" FontSize="9" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="8,0,3,0">
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock x:Name="PreviewIntervalTitle" Text="Intervalo" FontSize="8" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock x:Name="PreviewIntervalText" Text="150 ms" FontSize="8" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="PreviewIntervalSlider" Minimum="50" Maximum="2000" Value="150" TickFrequency="50" IsSnapToTickEnabled="False" ValueChanged="PreviewIntervalSlider_ValueChanged" Width="150" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="DropHint" Grid.RowSpan="3" Text="Abra ou arraste uma imagem aqui" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="2,2,2,7">
                        <TextBlock x:Name="SpritesTitle" Text="Sprites" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock x:Name="SliceCountText" Text="0" Foreground="{DynamicResource MutedBrush}" FontSize="9" DockPanel.Dock="Right" />
                    </DockPanel>
                    <ListBox x:Name="SpriteList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ButtonBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="5">
                                    <DockPanel>
                                        <Border Width="50" Height="50" Background="{StaticResource CheckerBrush}" CornerRadius="3" Margin="0,0,8,0">
                                            <Image Source="{Binding Bitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="9" />
                                            <TextBlock Text="{Binding Dimensions}" Foreground="{DynamicResource MutedBrush}" FontSize="8" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="ImportButton" Grid.Row="2" Content="Importar para SPR" Click="ImportButton_Click" IsEnabled="False" Margin="0,7,0,5" />
                    <Button x:Name="ExportButton" Grid.Row="3" Content="Exportar PNGs" Click="ExportButton_Click" IsEnabled="False" Margin="0,0,0,5" />
                    <Button x:Name="ClearButton" Grid.Row="4" Content="Limpar" Click="ClearButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
