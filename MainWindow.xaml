<Window x:Class="SpriteStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Editor Universe" Icon="Assets/SpriteStudio.png" Width="1500" Height="820" MinWidth="1240" MinHeight="680" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" StateChanged="MainWindow_StateChanged"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="WindowCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ComboSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False">
                    <Image Source="Assets/SpriteStudio.png" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock Text="Editor Universe" Foreground="{DynamicResource TextBrush}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button x:Name="MinimizeWindowButton" Style="{StaticResource WindowCaptionButtonStyle}" Click="MinimizeWindowButton_Click" ToolTip="Minimizar"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="—" Foreground="#67B7FF" FontSize="15" FontWeight="SemiBold" Margin="0,-5,0,0" />
                    </Button>
                    <Button x:Name="MaximizeWindowButton" Style="{StaticResource WindowCaptionButtonStyle}" Click="MaximizeWindowButton_Click" ToolTip="Maximizar"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="□" Foreground="#A8E879" FontSize="14" FontWeight="SemiBold" />
                    </Button>
                    <Button x:Name="CloseWindowButton" Style="{StaticResource WindowCaptionButtonStyle}" Click="CloseWindowButton_Click" ToolTip="Fechar"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="×" Foreground="#FF6868" FontSize="21" FontWeight="Light" Margin="0,-2,0,0" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Border Width="27" Height="27" CornerRadius="8" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0">
                        <TextBlock Text="✦" Foreground="{DynamicResource AccentTextBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="EDITOR UNIVERSE" FontWeight="Bold" FontSize="11" />
                        <TextBlock x:Name="BrandSubtitle" Text="Editor de sprites para Tibia" FontSize="9" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock x:Name="TopWorkspace" Text="EDITOR UNIVERSE" Foreground="{DynamicResource MutedBrush}" FontSize="9" VerticalAlignment="Center" />
                    <TextBlock Text="   /   " Foreground="{DynamicResource DetailLabelBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TopLibrary" Text="Biblioteca de sprites" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="SaveAllButton" Content="Salvar tudo" Click="SaveAllButton_Click" Padding="10,6" FontSize="10" Margin="0,0,6,0" IsEnabled="False" />
                    <Button x:Name="CompileAsButton" Content="Compilar como…" Click="CompileAsButton_Click" Padding="10,6" FontSize="10" Margin="0,0,6,0" IsEnabled="False" />
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackground}" CornerRadius="12" Padding="9,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock x:Name="StatusText" Text="Aguardando arquivo" Foreground="{DynamicResource MutedBrush}" FontSize="9" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="OtbStatusBadge" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackground}" CornerRadius="12" Padding="9,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="OtbStatusDot" Width="6" Height="6" Fill="{DynamicResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock x:Name="OtbStatusText" Text="items.otb" Foreground="{DynamicResource MutedBrush}" FontSize="9" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="SlicerButton" Content="Slicer" Click="SlicerButton_Click" Padding="10,6" FontSize="10" Margin="0,0,6,0" />
                    <Button x:Name="ImportFolderButton" Content="Importar pasta…" Click="ImportFolderButton_Click" Padding="10,6" FontSize="10" Margin="0,0,6,0" />
                    <Button x:Name="OpenDatButton" Content="Abrir DAT" Click="OpenDatButton_Click" Padding="10,6" FontSize="10" Margin="0,0,6,0" />
                    <Button x:Name="OpenServerItemsButton" Content="Abrir OTB/XML" Click="OpenServerItemsButton_Click" Padding="10,6" FontSize="10" Margin="0,0,6,0" />
                    <Button x:Name="OpenButton" Content="Abrir SPR" Click="OpenButton_Click" Padding="10,6" FontSize="10" Margin="0,0,6,0" />
                    <Button x:Name="PrimaryOpenButton" Content="＋  Abrir pasta do cliente" Style="{StaticResource PrimaryButton}" Padding="11,6" FontSize="10" Click="OpenFolderButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="286" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ObjectSpriteColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,8">
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="7,2">
                            <DockPanel>
                                <TextBlock x:Name="LanguageLabel" Text="Idioma" Foreground="{DynamicResource MutedBrush}" FontSize="9" VerticalAlignment="Center" />
                                <ComboBox x:Name="LanguageCombo" Width="130" BorderThickness="0" SelectionChanged="LanguageCombo_SelectionChanged" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Português (Brasil)" Tag="pt" IsSelected="True" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                </ComboBox>
                            </DockPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="7,2" Margin="0,6,0,0">
                            <DockPanel>
                                <TextBlock x:Name="ThemeLabel" Text="Tema" Foreground="{DynamicResource MutedBrush}" FontSize="9" VerticalAlignment="Center" />
                                <ComboBox x:Name="ThemeCombo" Width="150" BorderThickness="0" SelectionChanged="ThemeCombo_SelectionChanged" SelectedValuePath="Tag" HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Escuro" Tag="dark" />
                                    <ComboBoxItem Content="Object Build" Tag="object-build" />
                                    <ComboBoxItem Content="Claro" Tag="light" />
                                </ComboBox>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="PrivacyLabel" Text="Seus arquivos ficam no seu computador." TextWrapping="Wrap" FontSize="8" Foreground="{DynamicResource PrivacyTextBrush}" Margin="2,6,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <Grid Margin="10,12,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MaxHeight="400" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,8">
                        <StackPanel>
                            <TextBlock x:Name="InfoTitle" Text="Informações" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="19" /><RowDefinition Height="19" /><RowDefinition Height="19" />
                                    <RowDefinition Height="19" /><RowDefinition Height="19" /><RowDefinition Height="19" />
                                    <RowDefinition Height="19" /><RowDefinition Height="19" /><RowDefinition Height="19" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="ClientVersionLabel" Text="Versão:" Grid.Row="0" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                <TextBlock x:Name="ClientVersionValue" Text="—" Grid.Row="0" Grid.Column="1" Foreground="{DynamicResource AccentBrush}" FontSize="9" />
                                <TextBlock x:Name="SpriteDimensionLabel" Text="Dimensão:" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                <TextBlock Text="32 × 32" Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource AccentBrush}" FontSize="9" />
                                <TextBlock x:Name="DatSignatureLabel" Text="Assinatura DAT:" Grid.Row="2" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                <TextBlock x:Name="DatSignatureValue" Text="—" Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource AccentBrush}" FontSize="9" />
                                <TextBlock x:Name="SprSignatureLabel" Text="Assinatura SPR:" Grid.Row="3" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                <TextBlock x:Name="SprSignatureValue" Text="—" Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource AccentBrush}" FontSize="9" />
                                <TextBlock x:Name="ItemsCountLabel" Text="Itens:" Grid.Row="4" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                <TextBlock x:Name="ItemsCountValue" Text="—" Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource AccentBrush}" FontSize="9" />
                                <TextBlock x:Name="OutfitsCountLabel" Text="Outfits:" Grid.Row="5" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                <TextBlock x:Name="OutfitsCountValue" Text="—" Grid.Row="5" Grid.Column="1" Foreground="{DynamicResource AccentBrush}" FontSize="9" />
                                <TextBlock x:Name="EffectsCountLabel" Text="Efeitos:" Grid.Row="6" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                <TextBlock x:Name="EffectsCountValue" Text="—" Grid.Row="6" Grid.Column="1" Foreground="{DynamicResource AccentBrush}" FontSize="9" />
                                <TextBlock x:Name="MissilesCountLabel" Text="Projéteis:" Grid.Row="7" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                <TextBlock x:Name="MissilesCountValue" Text="—" Grid.Row="7" Grid.Column="1" Foreground="{DynamicResource AccentBrush}" FontSize="9" />
                                <TextBlock x:Name="SpritesCountLabel" Text="Sprites:" Grid.Row="8" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                <TextBlock x:Name="SpritesCountValue" Text="—" Grid.Row="8" Grid.Column="1" Foreground="{DynamicResource AccentBrush}" FontSize="9" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="2,9,2,7">
                        <TextBlock x:Name="CategorySectionLabel" Text="Categoria" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="1,0,0,4" Visibility="Collapsed" />
                        <ComboBox x:Name="CategoryCombo" Height="29" SelectionChanged="CategoryCombo_SelectionChanged" Visibility="Collapsed">
                            <ComboBoxItem Content="Itens" Tag="item" IsSelected="True" />
                            <ComboBoxItem Content="Outfits" Tag="outfit" />
                            <ComboBoxItem Content="Efeitos" Tag="effect" />
                            <ComboBoxItem Content="Projéteis" Tag="missile" />
                        </ComboBox>
                        <Button x:Name="BulkAnimationSpeedButton" Content="Velocidade de animação…" Style="{StaticResource SecondaryButton}" Margin="0,6,0,0" Padding="8,6" FontSize="9" Click="BulkAnimationSpeedButton_Click" Visibility="Collapsed" />
                    </StackPanel>

                    <Border Grid.Row="2" Background="{DynamicResource PreviewTileBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Margin="0,2,0,8" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="InfoPreviewEmptyText" Text="Selecione um objeto" Foreground="{DynamicResource SubtleTextBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="InfoPreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased" />
                            <CheckBox x:Name="ActualSizeCheckBox" Content="Tamanho real" ToolTip="Mostrar a mini prévia no tamanho nativo do sprite" Click="ActualSizeCheckBox_Click"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="5,2" Background="{DynamicResource PanelBackground}"
                                      Foreground="{DynamicResource MutedBrush}" FontSize="8" IsEnabled="False" Panel.ZIndex="1">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Grid x:Name="Root" Background="Transparent">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border x:Name="CheckBoxBorder" Width="14" Height="14" CornerRadius="2" Background="{DynamicResource PanelAlt}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="CheckMark" Text="✓" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                            </Border>
                                            <ContentPresenter Grid.Column="1" ContentSource="Content" RecognizesAccessKey="True"
                                                              VerticalAlignment="Center" Margin="5,0,0,0" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </CheckBox.Template>
                            </CheckBox>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="2,1,2,7">
                        <TextBlock x:Name="DetailIdLabel" Text="ID DO OBJETO" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource DetailLabelBrush}" />
                        <TextBlock x:Name="SelectedIdText" Text="—" FontSize="12" Margin="0,3,0,7" />
                        <TextBlock x:Name="DetailFileLabel" Text="ARQUIVO" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource DetailLabelBrush}" Visibility="Collapsed" />
                        <TextBlock x:Name="SelectedFileText" Text="—" FontSize="9" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,7" Visibility="Collapsed" />
                        <TextBlock x:Name="VersionLabel" Text="VERSÃO" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource DetailLabelBrush}" Visibility="Collapsed" />
                        <TextBlock x:Name="VersionText" Text="—" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,7" Visibility="Collapsed" />
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CanvasDimensionsLabel" Text="DIMENSÕES" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource DetailLabelBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="SelectedDimensionsText" Text="—" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="ExportButton" Content="↓ PNG" Padding="8,4" FontSize="9" IsEnabled="False" Click="ExportButton_Click" DockPanel.Dock="Right" />
                        </DockPanel>
                    </StackPanel>

                    </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="8,12,8,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="1,0,1,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SpritesTitle" Text="Objetos" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock x:Name="SpriteCountText" Text="—" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="8,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ListViewButton" Content="Lista" Style="{StaticResource PrimaryButton}" Padding="8,5" FontSize="9" Click="ListViewButton_Click" Margin="0,0,4,0" />
                            <Button x:Name="GridViewButton" Content="Grade" Padding="8,5" FontSize="9" Click="GridViewButton_Click" Margin="0,0,4,0" />
                            <Button x:Name="FindButton" Content="Buscar" Padding="8,5" FontSize="9" Click="FindButton_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="98" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="ViewModeCombo" Grid.Column="0" Height="29" Margin="0,0,5,0" SelectionChanged="ViewModeCombo_SelectionChanged" IsEnabled="False">
                            <ComboBoxItem Content="Sprites SPR" Tag="sprites" IsSelected="True" />
                            <ComboBoxItem Content="Objetos DAT" Tag="things" />
                        </ComboBox>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Height="29" Padding="8,5" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="10" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" IsEnabled="False" ToolTip="Buscar pelo ID" />
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                        <Grid>
                            <ScrollViewer x:Name="SpriteScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="SpriteGrid" />
                            </ScrollViewer>
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
                                <TextBlock x:Name="EmptyTitle" Text="Nenhum objeto encontrado" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" TextAlignment="Center" />
                                <TextBlock x:Name="EmptyBody" Text="Abra a pasta do cliente para carregar os arquivos." Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,5,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="DatActionToolbar" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed">
                        <Button x:Name="DatNewButton" Content="＋" Width="37" Height="29" Padding="0" Margin="1,0" FontSize="13" Click="DatNewButton_Click" />
                        <Button x:Name="DatReplaceButton" Content="↻" Width="37" Height="29" Padding="0" Margin="1,0" FontSize="13" Click="DatReplaceButton_Click" />
                        <Button x:Name="DatDuplicateButton" Content="⧉" Width="37" Height="29" Padding="0" Margin="1,0" FontSize="13" Click="DatDuplicateButton_Click" />
                        <Button x:Name="DatImportButton" Content="⇧" Width="37" Height="29" Padding="0" Margin="1,0" FontSize="13" Click="DatImportButton_Click" />
                        <Button x:Name="DatExportButton" Content="⇩" Width="37" Height="29" Padding="0" Margin="1,0" FontSize="13" Click="DatExportButton_Click" />
                        <Button x:Name="DatDeleteButton" Content="⌫" Width="37" Height="29" Padding="0" Margin="1,0" FontSize="13" Click="DatDeleteButton_Click" />
                    </StackPanel>
                    <StackPanel x:Name="PagerPanel" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed">
                        <Button x:Name="FirstPageButton" Content="|←" Padding="7,4" Click="FirstPageButton_Click" ToolTip="Primeira página" />
                        <Button x:Name="PreviousPageButton" Content="←" Padding="8,4" Click="PreviousPageButton_Click" />
                        <TextBlock x:Name="PageText" Text="Página 1 de 1" Foreground="{DynamicResource MutedBrush}" FontSize="9" VerticalAlignment="Center" Margin="10,0" />
                        <Button x:Name="NextPageButton" Content="→" Padding="8,4" Click="NextPageButton_Click" />
                        <Button x:Name="LastPageButton" Content="→|" Padding="7,4" Click="LastPageButton_Click" ToolTip="Última página" />
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="{DynamicResource ErrorBrush}" FontSize="9" TextWrapping="Wrap" Margin="2,7,2,0" Visibility="Collapsed" />
                </Grid>
            </Border>

            <Grid Grid.Column="2" Margin="10,10,10,10">
                <TabControl x:Name="WorkspaceTabs" Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Setter Property="Background" Value="{DynamicResource PreviewCanvasBrush}" />
                            <Setter Property="Padding" Value="13,7" />
                            <Setter Property="Margin" Value="0,0,3,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="5,5,0,0" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PanelBackground}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabBorder" Property="Opacity" Value="0.55" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel KeyboardNavigation.TabNavigation="Local">
                                <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,4,0,0">
                                    <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                                </Border>
                                <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="0,0,7,7" Padding="8">
