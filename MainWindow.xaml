                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <TextBlock x:Name="ServerItemIdLabel" Text="ID servidor" VerticalAlignment="Center" Margin="2,3,6,3" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                                <TextBox x:Name="ServerItemServerIdInput" Grid.Column="1" IsReadOnly="True" Height="22" Margin="0,2,8,2" Padding="4,1" Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="9" />
                                                <TextBlock x:Name="ServerItemClientIdLabel" Grid.Column="2" Text="ID cliente" VerticalAlignment="Center" Margin="2,3,6,3" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                                <TextBox x:Name="ServerItemClientIdInput" Grid.Column="3" IsReadOnly="True" Height="22" Margin="0,2,0,2" Padding="4,1" Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="9" />
                                                <TextBlock x:Name="ServerItemNameLabel" Grid.Row="1" Text="Nome OTB" VerticalAlignment="Center" Margin="2,3,6,3" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                                <TextBox x:Name="ServerItemNameInput" Grid.Row="1" Grid.Column="1" Height="22" Margin="0,2,8,2" Padding="4,1" Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="9" TextChanged="ServerItemField_TextChanged" Tag="otbName" />
                                                <TextBlock x:Name="ServerGroundSpeedLabel" Grid.Row="1" Grid.Column="2" Text="Velocidade do piso" VerticalAlignment="Center" Margin="2,3,6,3" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                                <TextBox x:Name="ServerGroundSpeedInput" Grid.Row="1" Grid.Column="3" Height="22" Margin="0,2,0,2" Padding="4,1" HorizontalContentAlignment="Right" Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="9" TextChanged="ServerItemField_TextChanged" Tag="groundSpeed" />
                                                <TextBlock x:Name="ServerMinimapLabel" Grid.Row="2" Text="Cor do minimapa" VerticalAlignment="Center" Margin="2,3,6,3" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                                <TextBox x:Name="ServerMinimapInput" Grid.Row="2" Grid.Column="1" Height="22" Margin="0,2,8,2" Padding="4,1" HorizontalContentAlignment="Right" Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="9" TextChanged="ServerItemField_TextChanged" Tag="minimapColor" />
                                                <TextBlock x:Name="ServerTradeAsLabel" Grid.Row="2" Grid.Column="2" Text="Trade as" VerticalAlignment="Center" Margin="2,3,6,3" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                                <TextBox x:Name="ServerTradeAsInput" Grid.Row="2" Grid.Column="3" Height="22" Margin="0,2,0,2" Padding="4,1" HorizontalContentAlignment="Right" Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="9" TextChanged="ServerItemField_TextChanged" Tag="tradeAs" />
                                                <TextBlock x:Name="ServerLightLevelLabel" Grid.Row="3" Text="Intensidade da luz" VerticalAlignment="Center" Margin="2,3,6,3" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                                <TextBox x:Name="ServerLightLevelInput" Grid.Row="3" Grid.Column="1" Height="22" Margin="0,2,8,2" Padding="4,1" HorizontalContentAlignment="Right" Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="9" TextChanged="ServerItemField_TextChanged" Tag="lightLevel" />
                                                <TextBlock x:Name="ServerLightColorLabel" Grid.Row="3" Grid.Column="2" Text="Cor da luz" VerticalAlignment="Center" Margin="2,3,6,3" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                                <TextBox x:Name="ServerLightColorInput" Grid.Row="3" Grid.Column="3" Height="22" Margin="0,2,0,2" Padding="4,1" HorizontalContentAlignment="Right" Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="9" TextChanged="ServerItemField_TextChanged" Tag="lightColor" />
                                                <TextBlock x:Name="ServerXmlNameLabel" Grid.Row="4" Text="Nome XML" VerticalAlignment="Center" Margin="2,3,6,3" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                                <TextBox x:Name="ServerXmlNameInput" Grid.Row="4" Grid.Column="1" Height="22" Margin="0,2,8,2" Padding="4,1" Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="9" TextChanged="ServerItemField_TextChanged" Tag="xmlName" />
                                                <TextBlock x:Name="ServerArticleLabel" Grid.Row="4" Grid.Column="2" Text="Artigo" VerticalAlignment="Center" Margin="2,3,6,3" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                                <TextBox x:Name="ServerArticleInput" Grid.Row="4" Grid.Column="3" Height="22" Margin="0,2,0,2" Padding="4,1" Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="9" TextChanged="ServerItemField_TextChanged" Tag="article" />
                                                <TextBlock x:Name="ServerPluralLabel" Grid.Row="5" Text="Plural" VerticalAlignment="Center" Margin="2,3,6,3" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                                <TextBox x:Name="ServerPluralInput" Grid.Row="5" Grid.Column="1" Height="22" Margin="0,2,8,2" Padding="4,1" Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="9" TextChanged="ServerItemField_TextChanged" Tag="plural" />
                                            </Grid>
                                            <DockPanel Margin="2,8,0,2">
                                                <TextBlock x:Name="ServerXmlAttributesTitle" Text="Atributos XML" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" />
                                                <Button x:Name="AddXmlAttributeButton" Content="＋ Atributo" DockPanel.Dock="Right" Padding="6,2" FontSize="8" Click="AddXmlAttributeButton_Click" />
                                            </DockPanel>
                                            <StackPanel x:Name="ServerXmlAttributesEditor" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="AttributesSaveHint" Text="As alterações são gravadas no DAT pelo botão Salvar DAT." Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="3,7,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
                <Button x:Name="CanvasExportButton" Content="↓ PNG" Padding="9,5" FontSize="9" Width="62" Height="29"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,8,0" IsEnabled="False" Click="ExportButton_Click" />
            </Grid>

            <Border x:Name="ObjectSpritePanel" Grid.Column="3" Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <Grid Margin="8,12,8,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="1,0,1,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ObjectSpritesTitle" Text="Sprites" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock x:Name="ObjectSpriteCountText" Text="—" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="7,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ObjectSpriteListButton" Content="Lista" Style="{StaticResource PrimaryButton}" Padding="7,5" FontSize="9" Click="ObjectSpriteListButton_Click" Margin="0,0,4,0" />
                            <Button x:Name="ObjectSpriteGridButton" Content="Grade" Padding="7,5" FontSize="9" Click="ObjectSpriteGridButton_Click" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                        <Grid>
                            <ScrollViewer x:Name="ObjectSpriteScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="ObjectSpriteGrid" />
                            </ScrollViewer>
                            <StackPanel x:Name="ObjectSpriteEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
                                <TextBlock x:Name="ObjectSpriteEmptyTitle" Text="Nenhum SPR aberto" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" TextAlignment="Center" />
                                <TextBlock x:Name="ObjectSpriteEmptyBody" Text="Abra um SPR para ver os sprites aqui." Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,5,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid x:Name="SpriteAssemblyToolbar" Grid.Row="2" Margin="0,6,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="SelectSpritePageButton" Content="Selecionar página" Padding="4,5" FontSize="8"
                                Click="SelectSpritePageButton_Click" Margin="1,0,3,0" />
                        <Button x:Name="AutoAssembleSpritesButton" Grid.Column="1" Content="Montar automaticamente" Style="{StaticResource PrimaryButton}"
                                Padding="4,5" FontSize="8" Click="AutoAssembleSpritesButton_Click" Margin="3,0,1,0" IsEnabled="False" />
                    </Grid>
                    <StackPanel x:Name="SpriteActionToolbar" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed">
                        <Button x:Name="NewSpriteButton" Content="＋" Width="37" Height="29" Padding="0" Margin="1,0" FontSize="13" Click="NewSpriteButton_Click" />
                        <Button x:Name="ReplaceSpriteButton" Content="↻" Width="37" Height="29" Padding="0" Margin="1,0" FontSize="13" Click="ReplaceSpriteButton_Click" />
                        <Button x:Name="DuplicateSpriteButton" Content="⧉" Width="37" Height="29" Padding="0" Margin="1,0" FontSize="13" Click="DuplicateSpriteButton_Click" />
                        <Button x:Name="ImportSpriteButton" Content="⇧" Width="37" Height="29" Padding="0" Margin="1,0" FontSize="13" Click="ImportSpriteButton_Click" />
                        <Button x:Name="ExportSpriteButton" Content="⇩" Width="37" Height="29" Padding="0" Margin="1,0" FontSize="13" Click="ExportSpriteButton_Click" />
                        <Button x:Name="DeleteSpriteButton" Content="⌫" Width="37" Height="29" Padding="0" Margin="1,0" FontSize="13" Click="DeleteSpriteButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ObjectSpriteRangeText" Grid.Row="4" Text="—" Foreground="{DynamicResource MutedBrush}" FontSize="8" HorizontalAlignment="Center" Margin="0,6,0,1" />
                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button x:Name="ObjectSpriteFirstButton" Content="|←" Width="29" Padding="3,4" FontSize="9" ToolTip="Primeiro sprite" Click="ObjectSpriteFirstButton_Click" />
                        <Button x:Name="ObjectSpritePreviousButton" Content="←" Width="29" Padding="3,4" FontSize="9" ToolTip="Sprite anterior" Click="ObjectSpritePreviousButton_Click" Margin="3,0,0,0" />
                        <TextBox x:Name="ObjectSpriteIdInput" Text="—" Width="72" Height="25" Padding="4,3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 Background="{DynamicResource PanelAlt}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="9" Margin="5,0"
                                 LostFocus="ObjectSpriteIdInput_LostFocus" PreviewKeyDown="ObjectSpriteIdInput_PreviewKeyDown" ToolTip="ID do sprite atual" />
                        <Button x:Name="ObjectSpriteNextButton" Content="→" Width="29" Padding="3,4" FontSize="9" ToolTip="Próximo sprite" Click="ObjectSpriteNextButton_Click" />
                        <Button x:Name="ObjectSpriteLastButton" Content="→|" Width="29" Padding="3,4" FontSize="9" ToolTip="Último sprite" Click="ObjectSpriteLastButton_Click" Margin="3,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
