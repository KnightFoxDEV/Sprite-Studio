<Window x:Class="SpriteStudio.SpriteSheetAssemblyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Montar spritesheet" Width="570" SizeToContent="Height" MinWidth="520" MaxWidth="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12" Icon="Assets/SpriteStudio.png">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText" Text="Montar um novo objeto" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="SourceInfoText" Text="spritesheet.png · 256 × 128 px"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,9,0">
                    <TextBlock x:Name="WidthLabel" Text="Largura (sprites)" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="1,0,0,5" />
                    <TextBox x:Name="WidthInput" Text="1" Height="34" Padding="9,6" VerticalContentAlignment="Center"
                             TextChanged="Options_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,9,0">
                    <TextBlock x:Name="HeightLabel" Text="Altura (sprites)" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="1,0,0,5" />
                    <TextBox x:Name="HeightInput" Text="1" Height="34" Padding="9,6" VerticalContentAlignment="Center"
                             TextChanged="Options_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,9,0">
                    <TextBlock x:Name="FrameCountLabel" Text="Animações" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="1,0,0,5" />
                    <TextBox x:Name="FrameCountInput" Text="1" Height="34" Padding="9,6" VerticalContentAlignment="Center"
                             TextChanged="Options_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock x:Name="CategoryLabel" Text="Criar como" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="1,0,0,5" />
                    <ComboBox x:Name="CategoryCombo" Height="34" Padding="8,5" SelectionChanged="Options_TextChanged">
                        <ComboBoxItem Tag="item" Content="Item" />
                        <ComboBoxItem Tag="effect" Content="Efeito" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource PanelInsetBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="FrameSizeText" Text="Cada quadro: 32 × 32 px" FontWeight="SemiBold" />
                <TextBlock x:Name="SheetLayoutText" Text="Os quadros serão lidos da esquerda para a direita e de cima para baixo."
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="ValidationText" Grid.Row="3" Foreground="{DynamicResource SoftErrorBrush}"
                   TextWrapping="Wrap" MinHeight="18" Margin="2,0,2,8" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
            <Button x:Name="CancelButton" Content="Cancelar" MinWidth="92" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="AssembleButton" Content="Montar" Style="{StaticResource PrimaryButton}"
                    MinWidth="112" IsDefault="True" Click="AssembleButton_Click" />
        </StackPanel>
    </Grid>
</Window>
